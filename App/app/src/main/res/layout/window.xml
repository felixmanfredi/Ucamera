<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:weightSum="1"


    >
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"


        >

        <LinearLayout
            android:id="@+id/main_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <FrameLayout
                android:id="@+id/windowbar"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:background="#2596be"
                >
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="2dp"
                    android:background="@mipmap/ic_launcher">
                </ImageView>
                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="22dp"
                    android:textColor="@color/white"
                    android:text="3DR UCamera">

                </TextView>

                <TextView
                    android:id="@+id/depth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:layout_gravity="end"
                    android:layout_marginEnd="46dp"
                    android:text="0.0 metri">

                </TextView>
                <Button
                    android:id="@+id/btn_fullscreen"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="22dp"
                    android:backgroundTint="@color/white"
                    android:minWidth="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:textSize="9sp"
                    android:text="FS">

                </Button>
                <Button
                    android:id="@+id/btn_collapse"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="2dp"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/down">

                </Button>
            </FrameLayout>

            <!-- Toolbar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                >
                <LinearLayout
                    android:id="@+id/body"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">


                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        >
                    <!--
                    <WebView
                        android:id="@+id/preview"
                        android:layout_width="150dp"
                        android:layout_height="match_parent">

                    </WebView>
                    -->

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/preview_container"
                            android:layout_width="150dp"
                            android:layout_height="match_parent">
                            <TextureView
                                android:id="@+id/preview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                            </TextureView>
                            <!--

                            <org.videolan.libvlc.util.VLCVideoLayout
                                android:id="@+id/preview"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                                -->
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <ImageView
                            android:id="@+id/recording"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="10dp"
                            android:src="@drawable/rectangle"
                            android:visibility="gone"

                            ></ImageView>

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:width="140dp"
                            android:text="Status"
                            android:textAlignment="textEnd"
                            android:textColor="@color/white"
                            android:textFontWeight="@integer/material_motion_duration_long_1"
                            android:textSize="7pt"></TextView>
                    </FrameLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >



                    <Button
                        android:id="@+id/btn_open_acquisition"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"

                        android:text="Acquisizione"></Button>
                    <Button
                        android:id="@+id/btn_open_config"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Parametri"></Button>
                    <Button
                        android:id="@+id/btn_open_other"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Altro"></Button>


                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- Acquisizioni -->
            <FrameLayout
                android:id="@+id/acquisition_panel"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:visibility="gone"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <include android:id="@+id/interval_control" layout="@layout/layout_param"></include>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <Button
                            android:id="@+id/btn_start_acquisition"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Avvia Scatto Foto">


                        </Button>
                        <Button
                            android:id="@+id/btn_start_video"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Avvia Video">


                        </Button>
                    </LinearLayout>



                </LinearLayout>




            </FrameLayout>

            <!-- Impostazioni -->
            <ScrollView
                android:id="@+id/settings_panel"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="150dp"

                android:visibility="gone"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"

                    >

                    <include android:id="@+id/brightness_control" layout="@layout/layout_param"></include>
                    <include android:id="@+id/contrast_control" layout="@layout/layout_param"></include>
                    <include android:id="@+id/sharpness_control" layout="@layout/layout_param"></include>
                    <include android:id="@+id/saturation_control" layout="@layout/layout_param"></include>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <include
                            android:id="@+id/lensposition_control"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            layout="@layout/layout_param"></include>

                        <Button
                            android:id="@+id/btn_autofocus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:minWidth="0dp"
                            android:paddingLeft="0dp"
                            android:paddingRight="0dp"
                            android:textSize="9sp"
                            android:text="--">
                        </Button>

                    </LinearLayout>

                    <!-- Parametri della RICERCA del fuoco. Contano solo quando e' la
                         camera a cercarlo (AF-S / AF-C): in manuale libcamera li ignora,
                         e su un device con il plugin vecchio non esistono proprio. In
                         entrambi i casi il gruppo sparisce, vedi
                         Window.updateControlsEnabled(). Parte "gone" perche' quando la
                         finestra viene creata le impostazioni non sono ancora arrivate. -->
                    <LinearLayout
                        android:id="@+id/af_search_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include android:id="@+id/afrange_control" layout="@layout/layout_param"></include>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <include
                                android:id="@+id/afspeed_control"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                layout="@layout/layout_param"></include>

                            <!-- Finestra di messa a fuoco: tutto il fotogramma oppure il
                                 riquadro centrale. A fotogramma pieno uno sfondo a forte
                                 contrasto puo' vincere sul soggetto, e la camera mette a
                                 fuoco dietro di esso. -->
                            <Button
                                android:id="@+id/btn_afwindow"
                                android:layout_width="56dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:minWidth="0dp"
                                android:paddingLeft="0dp"
                                android:paddingRight="0dp"
                                android:textSize="9sp"
                                android:text="--">
                            </Button>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <include
                            android:id="@+id/exposure_control"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            layout="@layout/layout_param"></include>

                        <!-- Esposizione automatica. Con AE attivo la camera riscrive
                             tempo e guadagno a ogni frame: i due gruppi di controlli si
                             escludono, e questo pulsante dice quale e' attivo. -->
                        <Button
                            android:id="@+id/btn_ae"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:minWidth="0dp"
                            android:paddingLeft="0dp"
                            android:paddingRight="0dp"
                            android:textSize="9sp"
                            android:text="AUTO">
                        </Button>

                    </LinearLayout>
                    <include android:id="@+id/exposuretime_control" layout="@layout/layout_param"></include>
                    <include android:id="@+id/gain_control" layout="@layout/layout_param"></include>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >
                        <Button
                            android:id="@+id/btn_preview_image"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Scatto di prova">

                        </Button>
                        <Button
                            android:id="@+id/btn_reset_settings"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Reset">

                        </Button>

                    </LinearLayout>


                </LinearLayout>






            </ScrollView>

            <!-- Altro -->
            <FrameLayout
                android:id="@+id/other_panel"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:visibility="gone"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btn_refresh_preview"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Aggiorna connessione"></Button>

                    <Button
                        android:id="@+id/btn_upload_firmware"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:visibility="gone"
                        android:text="Update Firmware"></Button>

                    <Button
                        android:id="@+id/btn_quit"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Esci"></Button>

                </LinearLayout>

            </FrameLayout>


        </LinearLayout>

    </FrameLayout>



</FrameLayout>